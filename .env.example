# OpenAI-compatible provider (the only one implemented)
LLM_PROVIDER=openai_compat
# vLLM from `make dev-llm`; Ollama works too: http://localhost:11434/v1 with LLM_MODEL=qwen3:8b
LLM_BASE_URL=http://localhost:8001/v1
LLM_MODEL=qwen3.5-9b
# Empty for local servers. Redacted from every span.
LLM_API_KEY=
# SQLite file, relative to backend/
AGENT_LAB_DB=data/agent_lab.db
# Further local model ids served by LLM_BASE_URL, comma-separated
# LLM_MODELS=
# OpenAI: models appear in the model list only when OPENAI_MODELS is set; without the key they
# are listed as unavailable. The key stays in .env and is redacted from every span.
# OPENAI_API_KEY=
# OPENAI_MODELS=gpt-6-luna
# OPENAI_BASE_URL=https://api.openai.com/v1
# reasoning_effort sent when an agent's reasoning is off; empty sends nothing
# OPENAI_REASONING_OFF=none
# Model of templates and agents set to "Default", as provider/model (default: local/$LLM_MODEL)
# DEFAULT_MODEL=local/qwen3.5-9b
