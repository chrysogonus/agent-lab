# Copy to .env and restart `make dev` after every change.

# Which model templates, "Default" agents and the village use: provider/model, where provider is
# local, openai or anthropic. Switch providers by uncommenting one line.
# Unset: the first LOCAL_MODELS entry.
# DEFAULT_MODEL=local/qwen3.5-9b
# DEFAULT_MODEL=openai/gpt-6-luna
# DEFAULT_MODEL=anthropic/claude-sonnet-5-5

# Each provider has the same three settings: base URL, models (comma-separated) and API key.
# Defaults are shown; a cloud provider only needs its key. Models without a key are listed as
# unavailable. Keys stay in .env (ignored by git) and are redacted from every span.

# Local OpenAI-compatible server: vLLM from `make dev-llm`, or Ollama
# (LOCAL_BASE_URL=http://localhost:11434/v1, LOCAL_MODELS=qwen3:8b)
LOCAL_BASE_URL=http://localhost:8001/v1
LOCAL_MODELS=qwen3.5-9b
LOCAL_API_KEY=

# OpenAI
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODELS=gpt-6-luna
OPENAI_API_KEY=
# reasoning_effort sent when an agent's thinking is off; empty sends nothing
# OPENAI_REASONING_OFF=none

# Anthropic (Claude)
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODELS=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# Only for a key not scoped to a workspace: the workspace to use (Console → Workspaces)
# ANTHROPIC_WORKSPACE_ID=

# SQLite file, relative to backend/
AGENT_LAB_DB=data/agent_lab.db
